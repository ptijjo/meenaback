// ======================================
// 📦 DATASOURCE & GENERATOR
// ======================================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ======================================
// 🔸 ENUMS
// ======================================
enum Role {
  user
  modo
  admin
}

enum RoleGroup {
  admin
  member
}

enum UserStatus {
  onLine
  away
  offLine
}

enum Method2Fa {
  email
  sms
  totp
}

enum TypeMessage {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  CALL
}

enum NotificationType {
  friend_request //nouvelle requete
  friend_accept //Quand le demande est acceptée
}

enum NotifiableType {
  friendship //Demande d'ami
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

// ======================================
// 👤 USER & AUTH
// ======================================
model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  password               String?
  name                   String
  phone                  String?
  phoneVerified          Boolean    @default(false)
  googleId               String?    @unique
  role                   Role       @default(user)
  status                 UserStatus @default(offLine)
  avatar                 String     @default("https://vibz.s3.eu-central-1.amazonaws.com/logo/photoProfil.png")
  is2FaEnable            Boolean    @default(false)
  twoFaSecret            String?    @unique //secret TOTP encodé en base32
  twoFaMethod            Method2Fa? @default(totp)
  twoFaVerified          Boolean    @default(false)
  failedLoginAttempts    Int        @default(0)
  lockedUntil            DateTime?
  desactivateAccountDate DateTime?
  isVerified             Boolean    @default(false)
  verificationToken      String?
  verificationExpiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  LoginHistory  LoginHistory[]
  Session       Session[]
  UserSecret    UserSecret?
  LoginAttempts LoginAttempts[]
}

// ======================================
// 🔐 AUTH RELATIONS
// ======================================
model UserSecret {
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameSecret   String
  avatarSecret String
  ID           String @id @unique

  // Relations
  DemandeurAmi          Friendship[]              @relation("FriendRequester")
  ReceveurAmi           Friendship[]              @relation("FriendAddressee")
  notificationReceveur  Notification[]            @relation(name: "receveur")
  notificationDemandeur Notification[]            @relation(name: "demandeur")
  conversationsCreated  Conversation[]            @relation("UserCreatedConversations")
  conversations         ConversationParticipant[]
  // Groupes & Chat
  groupsCreated         Group[]                   @relation("UserCreatedGroups")
  groupMembers          GroupMember[]
  messages              Message[]
  message               Message[]                 @relation("ReceivedMessages")

  messageRecipients MessageRecipient[]
}

model LoginHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique // identifiant unique du refresh token (JWT ID)
  userAgent String
  ipAddress String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  revokedAt DateTime?
}

model LoginAttempts {
  id        String   @id @default(cuid())
  emailName String
  email     User     @relation(fields: [emailName], references: [email], onDelete: Cascade)
  success   Boolean
  ipAddress String
  createdAt DateTime @default(now())
}

// ======================================
// 💬 GROUP SYSTEM
// ======================================
model Group {
  id          String     @id @default(cuid())
  name        String
  description String
  createdById String     @unique
  createdBy   UserSecret @relation("UserCreatedGroups", fields: [createdById], references: [ID],onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members      GroupMember[]
  conversation Conversation?
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String    
  groupId  String    
  role     RoleGroup @default(member)
  joinedAt DateTime  @default(now())

  user  UserSecret @relation(fields: [userId], references: [ID],onDelete: Cascade)
  group Group      @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester UserSecret @relation("FriendRequester", fields: [requesterId], references: [ID])
  addressee UserSecret @relation("FriendAddressee", fields: [addresseeId], references: [ID])

  @@unique([requesterId, addresseeId])
}

// ======================================
// 💭 CONVERSATION SYSTEM
// ======================================
model Conversation {
  id        String     @id @default(cuid())
  isGroup   Boolean    @default(false)
  groupId   String?    @unique
  group     Group?     @relation(fields: [groupId], references: [id])
  name      String?
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  authorId  String
  author    UserSecret @relation("UserCreatedConversations", fields: [authorId], references: [ID])

  participants ConversationParticipant[]
  messages     Message[]

  @@index([authorId])
  @@index([createdAt])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         UserSecret   @relation(fields: [userId], references: [ID])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
}

// ======================================
// 📨 MESSAGES
// ======================================
model Message {
  id             String      @id @default(cuid())
  content        String
  type           TypeMessage @default(TEXT)
  attachmentUrl  String?
  read           Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  receiverId     String?
  senderId       String
  conversationId String

  sender       UserSecret   @relation(fields: [senderId], references: [ID])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  receiver     UserSecret?   @relation("ReceivedMessages", fields: [receiverId], references: [ID])

  @@index([senderId])
  @@index([conversationId])
  @@index([createdAt])
  recipients MessageRecipient[]
}

model MessageRecipient {
  id         String   @id @default(cuid())
  messageId  String
  userId     String
  
  deliveredAt DateTime?
  readAt      DateTime?

  message    Message    @relation(fields: [messageId], references: [id])
  user       UserSecret @relation(fields: [userId], references: [ID])

  @@unique([messageId, userId]) // ✅ un seul recipient par user/message
}

//=======================================
// 🚨 NOTIFICATIONS
//=======================================
model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  targetId   String //"Pour avoir l'id de la story ajoutée ou message envoyé ou conversation crée"
  targetType NotifiableType //"Pour savoir s'il est mentionné dans un message ou tag dans une story"
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
  delivered  Boolean          @default(false)
  seenAt     DateTime?
  meta       Json?
  receiverId String
  receiver   UserSecret       @relation(name: "receveur", fields: [receiverId], references: [ID], onDelete: Cascade)
  senderId   String
  sender     UserSecret       @relation(name: "demandeur", fields: [senderId], references: [ID], onDelete: Cascade)
}
